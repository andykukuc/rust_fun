{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vulnwatch",
  "main": "build/worker/shim.mjs",
  "compatibility_date": "2026-09-08",
  // No public workers.dev URL. This Worker will ingest a homelab inventory
  // and serve findings, so it should never be reachable by default. Phase 3.1
  // gives it an authenticated route on a zone you control.
  "workers_dev": false,
  "build": {
    "command": "worker-build --release"
  }
  // D1 binding and cron triggers land in phase 3.1; deliberately absent
  // until the schema in migrations/0001_initial.sql is actually applied.
}
